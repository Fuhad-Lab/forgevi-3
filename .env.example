# ── Forgevi 3.0 engine configuration ─────────────────────────────────────
# One agent. One sandbox. No message bus, no workflow orchestrator, no
# judge loop — the model finishes the work itself or the user aborts.

# HTTP
ENGINE_PORT=3010
ENGINE_EXTRA_ORIGINS=http://localhost:3000

# Workspace grants (fg1. HMAC — same secret as the Arcforge backend mints with)
WORKSPACE_GRANT_SECRET=

# LLM provider: openrouter (default) | zai (local dev) | mock (probe)
ENGINE_PROVIDER=openrouter
ENGINE_MODEL=
OPENROUTER_API_KEY=

# MCP servers (auto-discovered at run start). JSON array:
# [{"name":"supabase","url":"https://mcp.supabase.com/mcp","headers":{"Authorization":"Bearer ..."}}]
MCP_SERVERS=

# E2B sandbox (unset → local-disk sandbox adapter for development)
E2B_API_KEY=
E2B_TEMPLATE_ID=

# Backblaze B2 (unset → engine-local persistence for development)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-west-004

# OpenTelemetry (unset → no-op)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Safety ceilings — OFF by default (user mandate: runs are free and dynamic;
# they end when the agent finishes or the user aborts). Optional ops limits:
FORGVI3_MAX_STEPS=0
FORGVI3_MAX_WALLCLOCK_MS=0
FORGVI3_MAX_TOKENS=0
ENGINE_MAX_CONCURRENT=3
